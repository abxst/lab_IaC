# cp .env.example .env  (docker compose tự đọc file .env)
# UID/GID của user trong container. Đặt bằng `id -u` / `id -g` của user trên host
# để file trong TOOLBOX_HOME sửa được từ cả hai phía (nếu SSH bằng root thì để 1000).
TOOLBOX_UID=1000
TOOLBOX_GID=1000

# Thư mục trên host chứa toàn bộ dữ liệu của toolbox. Nhớ backup thư mục này.
TOOLBOX_HOME=/opt/devops-toolbox/home
