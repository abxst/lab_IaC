# cp .env.example .env  (docker compose tự đọc file .env)

# Image do GitHub Actions build (.github/workflows/toolbox-image.yml).
# Muốn ghim một bản cụ thể thì dùng tag sha, ví dụ: ghcr.io/abxst/lab_iac/toolbox:sha-1a2b3c4
TOOLBOX_IMAGE=ghcr.io/abxst/lab_iac/toolbox:latest

# UID/GID của user trong container. Image trên GHCR được build với 1000:1000.
# Nếu user trên host có uid khác, sửa ở đây rồi build tại chỗ: docker compose up -d --build
TOOLBOX_UID=1000
TOOLBOX_GID=1000

# Thư mục trên host chứa toàn bộ dữ liệu của toolbox. Nhớ backup thư mục này.
TOOLBOX_HOME=/opt/devops-toolbox/home
